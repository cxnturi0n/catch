# Frontend build-time variables. Copy to .env.local for development.
# Base URL of the backend as the browser sees it. Default "/api" (same origin:
# Vite dev proxy locally, Caddy in production).
VITE_API_URL=/api
# Optional: Google Identity client id for the Sheets export feature.
VITE_GOOGLE_CLIENT_ID=
# Optional: Microsoft Clarity project id (consent-gated analytics).
VITE_CLARITY_PROJECT_ID=
# Optional: Sentry DSN for browser errors.
VITE_SENTRY_DSN=
