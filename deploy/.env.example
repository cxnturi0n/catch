# Copy to deploy/.env on the host (chmod 600). Never commit deploy/.env.
# Generated on the server by server-env.sh; one file per stack.
STACK=catch                       # compose project / container prefix (catch | catch-staging)
APP_ENV=production                # production | staging (staging allows demo seeding, shows a banner)
DB_PORT=5432                      # loopback port of this stack's Postgres (staging: 5433)
SITE_ADDRESS=localhost            # e.g. catch.example.com
STAGING_ADDRESS=                  # e.g. staging.catch.example.com, used by the shared edge only
IMAGE_TAG=local

POSTGRES_USER=catch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catch

# Backend
LOG_LEVEL=info
APP_URL=https://localhost        # public origin of the frontend (CORS, auth redirects)

# Auth (backend). AUTH_SECRET: openssl rand -base64 32
API_URL=https://localhost/api
AUTH_SECRET=replace-with-32-plus-random-characters-xxxxxxxx
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
CREDENTIALS_ENCRYPTION_KEYS=k1:replace-with-base64-32-bytes
RESEND_API_KEY=
EMAIL_FROM="Catch <onboarding@resend.dev>"

TELEGRAM_WEBHOOK_SECRET=

# Integrations v2. Discord gateway in the worker (false = REST polling only).
DISCORD_GATEWAY_ENABLED=true
# Telegram MTProto history import for public groups: dedicated account,
# api id/hash from my.telegram.org, session from scripts/telegram-session.ts.
# All three empty = feature off (connections still work, no history import).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# AI (Anthropic). AI_ENABLED=false is the kill switch: reports keep rule text, chat answers 503.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MODEL_REPORT=
AI_ENABLED=true

# Watchdog alert recipient (deploy/watchdog.sh)
ALERT_TO=
