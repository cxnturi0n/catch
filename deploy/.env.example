# Copy to deploy/.env on the host (chmod 600). Never commit deploy/.env.
SITE_ADDRESS=localhost            # e.g. catch.example.com
IMAGE_TAG=local

POSTGRES_USER=catch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catch

# Backend
LOG_LEVEL=info
APP_URL=https://localhost        # public origin of the frontend (CORS, auth redirects)
