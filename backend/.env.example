# Backend — copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=3000
# Public origin of the frontend (CORS, redirects, email links).
APP_URL=http://localhost:5173
# Public origin of this API as the browser sees it (OAuth callback base).
# With the Vite dev proxy the browser reaches the API at the SPA origin + /api.
API_URL=http://localhost:5173/api
DATABASE_URL=postgres://catch:catch@localhost:5432/catch

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-plus-random-characters-xxxxxxxx
# OAuth providers: a provider is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Telegram webhook shared secret (setWebhook secret_token). openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Secrets at rest (integration credentials, tokens). "<id>:<base64 32 bytes>".
# Generate: echo "k1:$(openssl rand -base64 32)"  — rotate by prepending a new id.
CREDENTIALS_ENCRYPTION_KEYS=k1:replace-with-base64-32-bytes

# Email via Resend. Leave empty in development: emails are printed to the log.
RESEND_API_KEY=
EMAIL_FROM="Catch <onboarding@resend.dev>"
